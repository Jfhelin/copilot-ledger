{
  "name": "@copilot-ledger/canvas-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Copilot CLI canvas extension that opens the cost view in a side panel.",
  "scripts": {
    "install-local": "mkdir -p \"$HOME/.copilot/extensions\" && ln -sfn \"$(pwd)\" \"$HOME/.copilot/extensions/copilot-ledger-canvas\" && echo 'Installed -> ~/.copilot/extensions/copilot-ledger-canvas'",
    "uninstall-local": "rm -f \"$HOME/.copilot/extensions/copilot-ledger-canvas\""
  }
}
